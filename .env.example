# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0 # Set to 1 or true to enable debug mode during local development
# Flask secret key: required in production (FLASK_ENV=production).
# In development, leave blank or omit to automatically generate a secure temporary key.
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
HOST=127.0.0.1
PORT=5000

# MongoDB Configuration (MongoDB Community Server is default)
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=nosql_evotrace
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# Fallback / Mock Database Settings
# Strictly 'false' by default. The application connects directly to MongoDB Community Server.
# If MongoDB is unavailable, the application fails clearly instead of silently switching to mongomock.
ALLOW_MOCK_FALLBACK=false

# Provenance View Settings
REDACT_SENSITIVE_PROVENANCE=false
